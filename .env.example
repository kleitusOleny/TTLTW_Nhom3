# --- Cấu hình dịch vụ bên thứ ba ---

# VNPAY (Thanh toán trực tuyến)
VNPAY_TMN_CODE=YOUR_VNPAY_TMN_CODE_HERE
VNPAY_HASH_SECRET=YOUR_VNPAY_HASH_SECRET_HERE

# Email gửi mã OTP / Thông báo (Gmail App Password)
EMAIL=your_email@gmail.com
APP_PASSWORD=your_app_password_here

# API Key cho tin tức/blog (nếu dùng)
NEWS_API_KEY=YOUR_NEWS_API_KEY_HERE

# Giao Hàng Nhanh (GHN)
GHN=YOUR_GHN_API_TOKEN_HERE
SHOP_ID_GHN=YOUR_GHN_SHOP_ID_HERE

# Giao Hàng Tiết Kiệm (GHTK)
GHTK_TOKEN=YOUR_GHTK_API_TOKEN_HERE
GHTK_PARTNER_CODE=YOUR_GHTK_PARTNER_CODE_HERE
SHOP_PROVINCE=Hồ Chí Minh
SHOP_DISTRICT=Thủ Đức
SHOP_WARD=Linh Trung
SHOP_NAME=Shop Rượu Vang
SHOP_TEL=0123456789
SHOP_ADDRESS=123 Đường ABC

# PayPal
PAYPAL_Client_ID=YOUR_PAYPAL_CLIENT_ID_HERE
PAYPAL_Secret=YOUR_PAYPAL_SECRET_HERE

# Google ReCAPTCHA
CAPTCHA_SECRETKEY=YOUR_CAPTCHA_SECRET_KEY_HERE

# Đăng nhập bằng Facebook
APP_ID_FB=YOUR_FACEBOOK_APP_ID_HERE
APP_SECRET_FB=YOUR_FACEBOOK_APP_SECRET_HERE
